{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["cypress", "node", "cypress-mochawesome-reporter"]
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts"]
}
